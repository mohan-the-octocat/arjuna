      {
        "xPos": 0,
        "yPos": 0,
        "width": 24,
        "height": 14,
        "widget": {
          "title": "Daily Active Users & Trajectories",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "dimensions": [
                  {
                    "column": "date",
                    "columnType": "STRING",
                    "maxBinCount": 30,
                    "sortColumn": "date",
                    "sortOrder": "SORT_ORDER_ASCENDING"
                  }
                ],
                "measures": [
                  {
                    "aggregationFunction": {
                      "parameters": [],
                      "type": "sum"
                    },
                    "column": "daily_active_users"
                  },
                  {
                    "aggregationFunction": {
                      "parameters": [],
                      "type": "sum"
                    },
                    "column": "total_trajectories"
                  }
                ],
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "opsAnalyticsQuery": {
                    "sql": "SELECT CAST(event_date AS STRING) AS date, SUM(daily_active_users) AS daily_active_users, SUM(total_trajectories) AS total_trajectories FROM `${PROJECT_ID}.${DATASET_ID}.v_ge_app_agy_adoption` GROUP BY date ORDER BY date ASC"
                  }
                }
              }
            ],
            "yAxis": {
              "label": "Count",
              "scale": "LINEAR"
            }
          }
        }
